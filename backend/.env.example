# Provedor de IA: fallback ou gemini
AI_PROVIDER=gemini

# Chave do Google AI Studio. Nunca coloque a chave real no GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# PostgreSQL em produção
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tribunal_virtual

# Origens permitidas do frontend, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
